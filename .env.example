# Crestwell Public Site — Environment Variables
# Copy to .env.local for local development

# ── Supabase (CTS project) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://zbtnulzvwreqzbmxulpv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key

# ── Stripe ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# ── Triton (AI Cruise Finder — /cruise-finder, app/api/triton) ──────────────────
# Server-only — never exposed to the browser, never a NEXT_PUBLIC_ var.
# See TRITON_NOTES.md for the Supabase-side secrets the edge function itself needs.
TRITON_URL=
AGENT_SECRET=

# ── Equifax Pre-Qual ──────────────────────────────────────────────────────────
# SANDBOX (default — safe for dev/test, no IP whitelist needed)
EQUIFAX_ENV=sandbox
EQUIFAX_CLIENT_ID=jdaapZkOP01ZMrC6V2E79QQOZbsGh4Zd
EQUIFAX_CLIENT_SECRET=qPOl7LC9i7qNycVZ
EQUIFAX_SUBSCRIBER_ID=jhTI62qfA6vG8xJdkrJYulOdARvF

# PRODUCTION (set EQUIFAX_ENV=production to activate)
# Requirements before going live:
#   1. Equifax approves production access
#   2. Add Vercel outbound IPs to Equifax whitelist
#      (see https://vercel.com/docs/edge-network/ip-ranges)
#      OR route through a fixed-IP proxy
#   3. Set these three vars in Vercel project settings
EQUIFAX_PROD_CLIENT_ID=
EQUIFAX_PROD_CLIENT_SECRET=
EQUIFAX_PROD_SUBSCRIBER_ID=
